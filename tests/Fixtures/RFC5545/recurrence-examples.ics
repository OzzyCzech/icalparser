BEGIN:VCALENDAR
PRODID:-//icalparser//RFC 5545 section 3.8.5.3//EN
VERSION:2.0
BEGIN:VEVENT
UID:rfc-monthly-first-friday@example.com
DTSTAMP:19970901T000000Z
DTSTART;TZID=America/New_York:19970905T090000
RRULE:FREQ=MONTHLY;COUNT=10;BYDAY=1FR
SUMMARY:Monthly on the first Friday for 10 occurrences
END:VEVENT
BEGIN:VEVENT
UID:rfc-second-to-last-weekday@example.com
DTSTAMP:19970901T000000Z
DTSTART;TZID=America/New_York:19970929T090000
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-2;COUNT=6
SUMMARY:The second-to-last weekday of the month
END:VEVENT
BEGIN:VEVENT
UID:rfc-election-day@example.com
DTSTAMP:19970901T000000Z
DTSTART;TZID=America/New_York:19961105T090000
RRULE:FREQ=YEARLY;INTERVAL=4;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8;COUNT=3
SUMMARY:U.S. Presidential Election day
END:VEVENT
BEGIN:VEVENT
UID:rfc-weekno@example.com
DTSTAMP:19970901T000000Z
DTSTART;TZID=America/New_York:19970512T090000
RRULE:FREQ=YEARLY;BYWEEKNO=20;BYDAY=MO;COUNT=3
SUMMARY:Monday of week number 20
END:VEVENT
END:VCALENDAR
