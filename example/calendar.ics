BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//om/icalparser//example//EN
X-WR-CALNAME:Example calendar
X-WR-TIMEZONE:Europe/Prague
BEGIN:VEVENT
UID:team-meeting@example.org
DTSTART;TZID=Europe/Prague:20260105T100000
DTEND;TZID=Europe/Prague:20260105T110000
RRULE:FREQ=WEEKLY;BYDAY=MO
EXDATE;TZID=Europe/Prague:20260406T100000
SUMMARY:Team meeting
LOCATION:Room 101
END:VEVENT
BEGIN:VEVENT
UID:team-meeting@example.org
RECURRENCE-ID;TZID=Europe/Prague:20260112T100000
DTSTART;TZID=Europe/Prague:20260113T140000
DTEND;TZID=Europe/Prague:20260113T150000
SUMMARY:Team meeting (moved to Tuesday)
LOCATION:Room 101
END:VEVENT
BEGIN:VEVENT
UID:review@example.org
DTSTART;TZID=Europe/Prague:20260130T150000
DURATION:PT1H30M
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1
SUMMARY:Monthly review (last workday of the month)
END:VEVENT
BEGIN:VEVENT
UID:new-year@example.org
DTSTART;VALUE=DATE:20260101
RRULE:FREQ=YEARLY
SUMMARY:New Year's Day
END:VEVENT
BEGIN:VEVENT
UID:conference@example.org
DTSTART;VALUE=DATE:20261014
DTEND;VALUE=DATE:20261017
SUMMARY:Conference
LOCATION:Prague\, Czech Republic
END:VEVENT
END:VCALENDAR
